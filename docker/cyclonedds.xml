<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="lo" />
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <FragmentSize>60000B</FragmentSize>
      <MaxMessageSize>10485760B</MaxMessageSize>
    </General>
    <Discovery>
      <SPDPInterval>100ms</SPDPInterval>
      <LeaseDuration>10s</LeaseDuration>
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>
    <Internal>
      <HeartbeatInterval>100ms</HeartbeatInterval>
      <NackDelay>50ms</NackDelay>
      <DeliveryQueueMaxSamples>1000</DeliveryQueueMaxSamples>
      <PrimaryReorderMaxSamples>256</PrimaryReorderMaxSamples>
      <SecondaryReorderMaxSamples>256</SecondaryReorderMaxSamples>
      <RetransmitMerging>always</RetransmitMerging>
    </Internal>
    <Tracing>
      <Verbosity>warning</Verbosity>
    </Tracing>
  </Domain>
</CycloneDDS>
